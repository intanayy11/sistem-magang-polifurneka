APP_NAME=SIMONIKA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_magang_polifurneka
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Konfigurasi Geofencing Presensi Polifurneka Kendal
PRESENSI_POLIFURNEKA_LAT=-6.929428
PRESENSI_POLIFURNEKA_LNG=110.256226
PRESENSI_RADIUS_METER=500

# Konfigurasi Jam Kerja Standar Presensi
PRESENSI_JAM_MASUK=07:30:00
PRESENSI_JAM_PULANG=16:00:00
PRESENSI_JAM_PULANG_JUMAT=16:30:00
